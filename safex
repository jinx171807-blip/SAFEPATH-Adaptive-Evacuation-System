const CONTROLS: { id: ScenarioId | "reset"; label: string }[] = [
  { id: "normal", label: "Normal condition" },
  { id: "crowdA", label: "Crowd Exit A" },
  { id: "blockA", label: "Block Exit A" },
  { id: "crowdB", label: "Crowd Exit B" },
  { id: "hazardC", label: "Smoke / hazard near C" },
  { id: "reset", label: "Reset" },
];

export function SimulationLab() {
  const [scenario, setScenario] = useState<ScenarioId>("normal");
  const [step, setStep] = useState(0);
  const [auto, setAuto] = useState(false);
  const [recalculating, setRecalculating] = useState(false);
  const timer = useRef<number | null>(null);

  const state = useMemo(() => buildState(scenario), [scenario]);

  const apply = useCallback((next: ScenarioId) => {
    setScenario(next);
    setRecalculating(true);
    window.setTimeout(() => setRecalculating(false), 1400);
  }, []);

  const goToStep = useCallback(
    (i: number) => {
      const idx = ((i % DEMO_STEPS.length) + DEMO_STEPS.length) % DEMO_STEPS.length;
      setStep(idx);
      apply(DEMO_STEPS[idx]!.scenario);
    },
    [apply],
  );

  useEffect(() => {
    if (!auto) return;
    timer.current = window.setInterval(() => {
      setStep((s) => {
        const next = (s + 1) % DEMO_STEPS.length;
        setScenario(DEMO_STEPS[next]!.scenario);
        setRecalculating(true);
        window.setTimeout(() => setRecalculating(false), 1400);
        return next;
      });
    }, 3200);
    return () => {
      if (timer.current) window.clearInterval(timer.current);
    };
  }, [auto]);

  const current = DEMO_STEPS[step]!;

  return (
    <div className="space-y-6">
      <div className="panel flex flex-wrap items-center gap-3 p-4">
        <span className="label-mono mr-2">Simulation controls</span>
        {CONTROLS.map((c) => {
          const active = c.id !== "reset" && scenario === c.id;
          return (
            <button
              key={c.id}
              type="button"
              onClick={() => {
                setAuto(false);
                if (c.id === "reset") {
                  setStep(0);
                  apply("normal");
                } else apply(c.id);
              }}
              aria-pressed={c.id === "reset" ? undefined : active}
              className={`rounded-md border px-3 py-2 font-mono text-xs tracking-widest uppercase transition-colors ${
                active
                  ? "border-tech bg-tech text-primary-foreground"
                  : "border-border bg-secondary text-foreground hover:bg-accent"
              }`}
            >
              {c.id === "reset" && <RotateCcw className="mr-2 inline size-3.5" aria-hidden />}
              {c.label}
            </button>
          );
        })}
      </div>

      <div className="panel p-4">
        <div className="flex flex-wrap items-center justify-between gap-3">
          <span className="label-mono">
            Demo mode · {current.title} · condition {SCENARIOS[scenario].short}
          </span>
          <div className="flex gap-2">
            <button
              type="button"
              onClick={() => setAuto((a) => !a)}
              className="flex items-center gap-2 rounded-md border border-tech/60 px-3 py-2 font-mono text-xs tracking-widest text-tech uppercase hover:bg-accent"
            >
              {auto ? <Pause className="size-3.5" aria-hidden /> : <Play className="size-3.5" aria-hidden />}
              {auto ? "Pause auto demo" : "Auto demo"}
            </button>
            <button
              type="button"
              onClick={() => {
                setAuto(false);
                goToStep(step + 1);
              }}
              className="flex items-center gap-2 rounded-md border border-border px-3 py-2 font-mono text-xs tracking-widest uppercase hover:bg-accent"
            >
              <SkipForward className="size-3.5" aria-hidden /> Next step
            </button>
          </div>
        </div>
        <div className="mt-4 grid gap-1 sm:grid-cols-7">
          {DEMO_STEPS.map((s, i) => (
            <button
              key={s.title}
              type="button"
              onClick={() => {
                setAuto(false);
                goToStep(i);
              }}
              className={`h-1.5 rounded-full transition-colors ${i <= step ? "bg-tech" : "bg-border"}`}
              aria-label={s.title}
            />
          ))}
        </div>
        <p className="mt-4 text-sm text-muted-foreground" aria-live="polite">
          <span className="text-foreground">{current.title}:</span> {current.body}
        </p>
      </div>

      <div className="grid gap-6 lg:grid-cols-[1.5fr_1fr]">
        <DigitalTwin state={state} />
        <div className="space-y-6">
          <ExitRecommendation state={state} />
          <div className="panel p-4">
            <p className="label-mono">Why the routing changed</p>
            <p className="mt-2 text-sm text-muted-foreground">{state.note}</p>
          </div>
        </div>
      </div>

      <Dashboard state={state} />
      <ZoneRouting state={state} />
      <div className="grid gap-6 lg:grid-cols-2">
        <RiskBreakdownTable state={state} />
        <RouteGraph state={state} recalculating={recalculating} />
      </div>
    </div>
  );
