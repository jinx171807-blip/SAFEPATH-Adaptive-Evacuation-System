const STROKE: Record<RouteState, string> = {
  safe: "var(--color-safe)",
  crowded: "var(--color-warn)",
  blocked: "var(--color-danger)",
};

const GX: Record<string, { x: number; y: number }> = {
  A: { x: 140, y: 90 },
  B: { x: 330, y: 90 },
  C: { x: 330, y: 190 },
  D: { x: 140, y: 190 },
  E: { x: 140, y: 290 },
  F: { x: 330, y: 290 },
  EXIT_A: { x: 520, y: 60 },
  EXIT_C: { x: 520, y: 190 },
  EXIT_B: { x: 520, y: 320 },
};

export function RouteGraph({ state, recalculating }: { state: SimulationState; recalculating: boolean }) {
  const active = new Set<string>();
  Object.values(state.routes).forEach((r) => {
    for (let i = 0; i < r.path.length - 1; i++) active.add(edgeKey(r.path[i]!, r.path[i + 1]!));
  });

  return (
    <div className="panel">
      <div className="flex items-center justify-between border-b border-border px-4 py-3">
        <span className="label-mono">Route engine — weighted safety graph</span>
        <span
          className={`label-mono text-tech transition-opacity ${recalculating ? "opacity-100" : "opacity-0"}`}
          aria-live="polite"
        >
          Route recalculated
        </span>
      </div>
      <svg viewBox="0 0 620 380" className="w-full" role="img" aria-label="Route engine graph">
        {EDGES.filter(([a, b]) => GX[a] && GX[b]).map(([a, b]) => {
          const key = edgeKey(a, b);
          const st = state.edgeState[key] ?? "safe";
          const on = active.has(key);
          return (
            <line
              key={key}
              x1={GX[a]!.x}
              y1={GX[a]!.y}
              x2={GX[b]!.x}
              y2={GX[b]!.y}
              stroke={STROKE[st]}
              strokeWidth={on ? 4 : 2}
              strokeOpacity={on ? 1 : 0.35}
              strokeDasharray={st === "blocked" ? "6 8" : undefined}
            />
          );
        })}
        {Object.entries(GX).map(([id, p]) => {
          const isExit = id.startsWith("EXIT");
          const st = isExit ? state.risk[id as "EXIT_A"].state : "safe";
          return (
            <g key={id}>
              <circle
                cx={p.x}
                cy={p.y}
                r={isExit ? 18 : 14}
                fill="var(--color-surface-2)"
                stroke={isExit ? STROKE[st] : "var(--color-tech)"}
                strokeWidth={2}
              />
              <text
                x={p.x}
                y={p.y + 4}
                textAnchor="middle"
                className="fill-foreground font-mono text-[12px]"
              >
                {isExit ? id.slice(-1) : id}
              </text>
              {isExit && (
                <text
                  x={p.x + 28}
                  y={p.y + 4}
                  className="fill-muted-foreground font-mono text-[12px] uppercase"
                >
                  Exit {id.slice(-1)} · {st}
                </text>
              )}
            </g>
          );
        })}
      </svg>
      <p className="border-t border-border px-4 py-3 text-sm text-muted-foreground">
        Edge weights are corridor length multiplied by a state penalty. Blocked edges are removed,
        then a shortest-path solve runs per zone.
      </p>
    </div>
  );
}

