const STATE_STROKE: Record<RouteState, string> = {
  safe: "var(--color-safe)",
  crowded: "var(--color-warn)",
  blocked: "var(--color-danger)",
};

const ZONE_ROOMS: Record<ZoneId, { x: number; y: number; w: number; h: number }> = {
  Z1: { x: 56, y: 84, w: 190, h: 132 },
